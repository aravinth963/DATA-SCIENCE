   "source": [
    "# Sales"
   ]
  },
  {
   "cell_type": "raw",
   "id": "0d8ff323-1138-4fc7-947f-15644a475461",
   "metadata": {},
   "source": [
    "| order_id | customer | product  | quantity | price | order_date |\n",
    "| -------- | -------- | -------- | -------- | ----- | ---------- |\n",
    "| 1        | A        | Laptop   | 1        | 60000 | 2024-01-01 |\n",
    "| 2        | B        | Mouse    | 2        | 500   | 2024-01-02 |\n",
    "| 3        | C        | Keyboard | 1        | 1200  | 2024-01-02 |\n",
    "| 4        | A        | Monitor  | 1        | 15000 | 2024-01-05 |\n",
    "| 5        | B        | Laptop   | 1        | 62000 | 2024-01-08 |\n",
    "| 6        | D        | Mouse    | 5        | 500   | 2024-01-09 |\n",
    "| 7        | C        | Laptop   | 1        | 61000 | 2024-01-11 |\n",
    "| 8        | A        | Keyboard | 2        | 1200  | 2024-01-15 |\n",
    "| 9        | D        | Monitor  | 1        | 15500 | 2024-01-20 |\n",
    "| 10       | B        | Laptop   | 1        | 60000 | 2024-01-22 |\n"
   ]
  },
  {
   "cell_type": "raw",
   "id": "1612a1ee-7ead-4f01-808c-5212e4809a58",
   "metadata": {},
   "source": [
    "1) Calculate total sales.\n",
    "\n",
    "select sum(quantity * price) from sales;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "6db40d55-4b0b-4415-ab91-961e644b4d31",
   "metadata": {},
   "source": [
    "2) Find customer who spent the most.\n",
    "\n",
    "select customer,sum(price*quantity) as total_price from sales group by customer having total_price order by total_price desc limit 1;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "68b9ae52-4f1f-4c7f-b127-2331ba2fea8b",
   "metadata": {},
   "source": [
    "3) Find best-selling product.\n",
    "\n",
    "select product, sum(quantity) as total_sold_product from sales group by product order by product;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "04860063-df91-4152-8484-af1aac75faad",
   "metadata": {},
   "source": [
    "4) Find daily sales.\n",
    "\n",
    "select order_date, sum(quantity * price) as daily_revenue from sales group by order_date order by order_date asc;"
   ]
  },
  {
   "cell_type": "raw",
