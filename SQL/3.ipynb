   "id": "484399d8-f053-4de5-8725-f9999fc84dd4",
   "metadata": {},
   "source": [
    "# Students table"
   ]
  },
  {
   "cell_type": "raw",
   "id": "251881e1-ba64-40a1-9069-b27f7a4709d5",
   "metadata": {},
   "source": [
    "| student_id | name    | department | marks | age | city    |\n",
    "| ---------- | ------- | ---------- | ----- | --- | ------- |\n",
    "| 1          | Ajay    | CSE        | 90    | 20  | Chennai |\n",
    "| 2          | Priya   | ECE        | 85    | 21  | Madurai |\n",
    "| 3          | Arun    | CSE        | 78    | 20  | Salem   |\n",
    "| 4          | Divya   | EEE        | 95    | 22  | Trichy  |\n",
    "| 5          | John    | CSE        | 88    | 21  | Chennai |\n",
    "| 6          | Meena   | ECE        | 70    | 20  | Madurai |\n",
    "| 7          | Karthik | CSE        | 60    | 22  | Salem   |\n",
    "| 8          | Anitha  | IT         | 99    | 21  | Chennai |\n",
    "| 9          | Rahul   | IT         | 84    | 20  | Trichy  |\n",
    "| 10         | Sneha   | EEE        | 75    | 21  | Madurai |\n"
   ]
  },
  {
   "cell_type": "raw",
   "id": "264a578f-aaa3-4125-bdc9-29cd243377fa",
   "metadata": {},
   "source": [
    "1) Find topper.\n",
    "\n",
    "select name,marks, dense_rank() over(order by marks desc) as student_rank from students;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "66070742-b908-4f64-a453-faf63189c405",
   "metadata": {},
   "source": [
    "2) Find average marks.\n",
    "\n",
    "select avg(marks) from students;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "1a968d17-2b9a-4550-97cc-2e1bc4cc9cbf",
   "metadata": {},
   "source": [
    "3) Count students department-wise.\n",
    "\n",
    "select department, count(*) from students group by department;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "356747b0-4765-4721-a809-c966910a3fb4",
   "metadata": {},
   "source": [
    "4) Find students scoring above average.\n",
    "\n",
    "select name, marks from students where marks > (select avg(marks) from students );"
   ]
  },
  {
   "cell_type": "raw",
   "id": "4b958f99-887a-4e17-a0e0-f4c7b2eb59d3",
   "metadata": {},
   "source": [
    "5) 5) Find the top 3 highest scorers.\n",
    "\n",
    "select name, marks from students order by marks desc limit 3;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "9bcd2b3b-f772-4924-b51c-bed659691ec5",
   "metadata": {},
   "source": [
    "6) Find the highest marks in each department.\n",
    "\n",
    "select department,max(marks) group by department from students;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "38c3deef-6123-4ba1-aea7-60e69222de02",
   "metadata": {},
   "source": [
    "7)Find second highest marks.\n",
    "\n",
    "select name, mark from students order by desc limit 1 offset 1;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "01ddbcd6-55b2-47b2-8ba9-9cca93ce66b2",
   "metadata": {},
   "source": [
    "8) Find students between 80 and 90.\n",
    "\n",
    "select name,marks from students order by marks where marks >= 80 || marks <= 90;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "0b6b8afd-4b2e-4b78-a62e-2a24e188da1f",
   "metadata": {},
   "source": [
    "9) Find students whose city is Chennai.\n",
    "\n",
    "select name, city from students where city = \"Chennai\";"
   ]
  },
  {
   "cell_type": "raw",
   "id": "fef46e6a-d95d-47a5-8e16-965b36e55767",
   "metadata": {},
   "source": [
    "10) Count students city-wise.\n",
    "\n",
    "select city, count(*) from students group by city having count(*) > 0;\n",
    "\n",
    "select city, group_concat(name),count(*) from students group by city havi\n",
    "ng count(*) > 0;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "cbce191a-7ac6-4585-a405-d402bd31e2fd",
   "metadata": {},
   "source": [
    "11) Find departments having more than 2 students.\n",
    "\n",
    "select department, count(*) from students group by department having count(*) > 2;"
   ]
  },
  {
   "cell_type": "raw",
   "id": "8a5c60b2-c389-4823-a422-f3da3ad65de0",
   "metadata": {},
   "source": [
    "12) Rank students by marks.\n",
    "\n",
    "select name, marks, dense_rank() over(marks order by desc) from students;"
   ]
  }
