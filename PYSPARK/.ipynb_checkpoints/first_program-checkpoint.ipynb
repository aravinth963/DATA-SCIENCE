   "source": [
    "from pyspark.sql import SparkSession\n",
    "\n",
    "\n",
    "spark session = it is entry point of every pyspark application\n",
    "with out it: cannot read csv, cannot create dataframe, cannot run sql, cannot process data\n",
    "\n",
    "SparkSession.builder = i want to create spark session\n",
    "\n",
    ".appName(\"Student example\") = application name\n",
    "\n",
    "getOrCreate() = if spark session already exits use it, otherwise, create new one\n",
    "\n",
    "\n",
    "spark = sparksession.builder.appName(\"student example\").getOrCreate()\n"
   ]
  },
  {
   "cell_type": "code",
